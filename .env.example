# Copy to .env. Never commit .env.

# --- Extraction provider (set the one you configured in config.yaml) ---

# Gemini free tier -- no card required. Key from https://aistudio.google.com/apikey
# This is the default provider in config.example.yaml.
GEMINI_API_KEY=

# Anthropic (paid). Key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Leave the one you are not using blank or commented out. An empty value is fine;
# a leftover placeholder is not -- `lavabo check` will tell you which you have.

# --- Zalo OA (only for the webhook flow, docs/07-zalo-oa-flow.md) ---
# ZALO_APP_ID=
# ZALO_OA_SECRET=
# ZALO_OA_ACCESS_TOKEN=

# --- Meta ---
# Long-lived PAGE access token (not a user token). See docs/04-meta-setup.md.
META_PAGE_TOKEN=EAA...

# Only needed while exchanging tokens, not at runtime.
# META_APP_ID=
# META_APP_SECRET=
